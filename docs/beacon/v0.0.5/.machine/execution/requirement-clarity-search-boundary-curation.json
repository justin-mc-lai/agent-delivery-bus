      "acceptance_criteria": [
        {
          "ac_id": "AC-SBC-001",
          "description": "adb boundary ingest 写入 awaiting_review（topic 必填；query_hints/sources 可多值；须带 project_profile_ref；自媒体路径另带 account_profile_ref）；缺 topic/画像 ref 拒绝"
        },
        {
          "ac_id": "AC-SBC-002",
          "description": "CLI 列出全部 awaiting_review；show 返回单条（含画像 ref）"
        },
        {
          "ac_id": "AC-SBC-003",
          "description": "reject；approve→active，reject→rejected"
        },
        {
          "ac_id": "AC-SBC-004",
          "description": "adb boundary list 默认仅 active；可用 --status 过滤"
        },
        {
          "ac_id": "AC-SBC-005",
          "description": "待审提案进入 approvals awaiting（kind 绑定 boundary 待审）"
        },
        {
          "ac_id": "AC-SBC-006",
          "description": "定时路径：schedule + Hermes cron 日更；脚本只 ingest 不 auto-approve；默认产出 5 条垂直约束提案"
        },
        {
          "ac_id": "AC-SBC-007",
          "description": "illegal：ingest 直达 active、跳过待审启用、自动 approve → fail-closed"
        },
        {
          "ac_id": "AC-SBC-008",
          "description": "L1：无 project_profile_ref（及自媒体缺 account_profile_ref）不得 ingest；禁止无画像静态离题池"
        },
        {
          "ac_id": "AC-SBC-009",
          "description": "L2/L3：可加载审计 ProjectVerticalProfile 与 AccountVerticalProfile；库拾样例 vertical=oss-picks，贴图=image_post 非表情包，out_of_scope 含表情包/情感漫等"
        },
        {
          "ac_id": "AC-SBC-010",
          "description": "L4 VerticalGate：完整偏离项目/账号垂直（如表情包题）→ reason_code=vertical_gate_rejected，不得进入 awaiting_review；有意义价值陈述可通过"
        },
        {
          "ac_id": "AC-SBC-011",
          "description": "日批选题均绑定库拾画像且主题落在 GitHub 开源 AI 库 / AI Spec；题库与脚本不得含表情包/情侣/宠物等离题词；provenance 标明 intel-radar 或 in-vertical-fixture"
        }
      ],
